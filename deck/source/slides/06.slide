<Slide style={{ width: 1280, height: 720, padding: '34px 48px 78px 48px', background: '#FFFFFF', fontFamily: 'Calibri', display: 'flex', flexDirection: 'column', position: 'relative' }}>

    <Box style={{ position: 'absolute', left: 0, bottom: 0, width: 1280, height: 56, background: '#0070C0', flexDirection: 'row', alignItems: 'center', padding: '0 48px' }}>
        <Box style={{ width: 210 }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>B.J.P (Bug Janta Party)</Text>
        </Box>
        <Box style={{ flex: 1, alignItems: 'center' }}>
            <Text style={{ fontSize: 13, color: '#FFFFFF' }}>@SIH Idea submission- Template</Text>
        </Box>
        <Box style={{ width: 210, alignItems: 'flex-end' }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF' }}>6 / 6</Text>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 74 }}>
        <Box style={{ width: 150, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', height: 56, borderRadius: 28, border: '1.5px solid #7030A0' }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#7030A0', textAlign: 'center', lineHeight: 1.2 }}>B.J.P{'\n'}Bug Janta{'\n'}Party</Text>
        </Box>
        <Box style={{ flex: 1, alignItems: 'center' }}>
            <Text style={{ fontSize: 44, fontWeight: 'bold', fontFamily: 'Times New Roman', color: '#1A1A1A', textAlign: 'center' }}>
                RESEARCH AND REFERENCES
            </Text>
            <Text style={{ fontSize: 18, color: '#5F5E5A', marginTop: 4 }}>Details / Links of the reference and research work</Text>
        </Box>
        <Box style={{ width: 150, alignItems: 'flex-end' }}>
            <Image src='assets/sih_logo.png' style={{ width: 140, height: 66 }} />
        </Box>
    </Box>

    <Box style={{ flexDirection: 'column', marginTop: 14, flex: 1 }}>

        <Box style={{ flexDirection: 'row', gap: 20, height: 286, alignItems: 'stretch' }}>

            <Box style={{ flex: 1, border: '1px solid #B4B2A9', borderRadius: 6, padding: 16, flexDirection: 'column', height: 286 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ padding: '5px 12px', background: '#01467D', borderRadius: 4 }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>Models and runtime</Text>
                    </Box>
                </Box>

                <Box style={{ flexDirection: 'column', gap: 12, marginTop: 14 }}>
                    {[
                        { k: 'ASR model', v: 'csukuangfj/sherpa-onnx-omnilingual-asr-1600-languages-300M-ctc-int8-2025-11-12', m: 'Apache 2.0 · 348.4 MB · INT8' },
                        { k: 'TTS voices', v: 'rhasspy/piper-voices — hi_IN pratham, en_US lessac', m: 'MIT · 60.6 MB + 60.3 MB · VITS' },
                        { k: 'Runtime', v: 'k2-fsa/sherpa-onnx v1.13.8 + sherpa-onnx-v1.13.8-android native libs', m: 'Apache 2.0 · arm64-v8a' },
                        { k: 'Voice activity detection', v: 'Silero VAD — pause and boundary detection', m: 'MIT · 0.6 MB · RTF 0.004' },
                    ].map((r, i) => (
                        <Box key={i} style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                            <Text style={{ width: 132, fontSize: 13.5, fontWeight: 'bold', color: '#01467D', lineHeight: 1.3 }}>{r.k}</Text>
                            <Box style={{ flex: 1 }}>
                                <Text style={{ fontSize: 13, color: '#1A1A1A', lineHeight: 1.35 }}>{r.v}</Text>
                                <Text style={{ fontSize: 12, color: '#5F5E5A', marginTop: 2 }}>{r.m}</Text>
                            </Box>
                        </Box>
                    ))}
                </Box>
            </Box>

            <Box style={{ flex: 1, border: '1px solid #B4B2A9', borderRadius: 6, padding: 16, flexDirection: 'column', height: 286 }}>
                <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
                    <Box style={{ padding: '5px 12px', background: '#0070C0', borderRadius: 4 }}>
                        <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>Evaluation data and platform</Text>
                    </Box>
                </Box>

                <Box style={{ flexDirection: 'column', gap: 12, marginTop: 14 }}>
                    {[
                        { k: 'Speech corpus', v: 'google/fleurs — real recorded human speech, all ten PS-mandated languages', m: 'CC-BY-4.0 · 200 clips per language, 2,000 clips, 6.72 h · evaluation only, not shipped' },
                        { k: 'Transport docs', v: 'developer.android.com — Bluetooth RFCOMM and Wi-Fi Direct guides', m: 'Platform documentation' },
                        { k: 'Audio APIs', v: 'AudioRecord 16 kHz · AudioTrack 22 050 Hz · AudioManager STREAM_ALARM', m: 'Android platform, API 21+' },
                        { k: 'Reproducibility', v: 'fleurs_eval_full.py · tts_intelligibility.py · measure_ram_all.py · end_to_end.py', m: 'Every figure in this deck is reproducible from these scripts' },
                    ].map((r, i) => (
                        <Box key={i} style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
                            <Text style={{ width: 132, fontSize: 13.5, fontWeight: 'bold', color: '#01467D', lineHeight: 1.3 }}>{r.k}</Text>
                            <Box style={{ flex: 1 }}>
                                <Text style={{ fontSize: 13, color: '#1A1A1A', lineHeight: 1.35 }}>{r.v}</Text>
                                <Text style={{ fontSize: 12, color: '#5F5E5A', marginTop: 2 }}>{r.m}</Text>
                            </Box>
                        </Box>
                    ))}
                </Box>
            </Box>

        </Box>

        <Box style={{ flex: 1 }} />

        <Box style={{ padding: '14px 18px', background: '#F4F8FC', border: '1px solid #B4B2A9', borderLeft: '4px solid #01467D', borderRadius: 4 }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#01467D' }}>Licensing, component by component</Text>
            <Text style={{ fontSize: 13, color: '#1A1A1A', lineHeight: 1.5, marginTop: 6 }}>
                ASR model <span style={{ fontWeight: 'bold' }}>Apache 2.0</span> &nbsp;·&nbsp; Piper voices <span style={{ fontWeight: 'bold' }}>MIT</span> &nbsp;·&nbsp; Silero VAD <span style={{ fontWeight: 'bold' }}>MIT</span> &nbsp;·&nbsp; sherpa-onnx runtime <span style={{ fontWeight: 'bold' }}>Apache 2.0</span> &nbsp;·&nbsp; AndroidX / Material <span style={{ fontWeight: 'bold' }}>Apache 2.0</span> &nbsp;·&nbsp; espeak-ng-data <span style={{ fontWeight: 'bold', color: '#C00000' }}>GPL (phoneme dictionaries)</span> — redistribution obligation flagged for review.
            </Text>
            <Text style={{ fontSize: 12.5, color: '#5F5E5A', lineHeight: 1.4, marginTop: 6 }}>
                No CC-BY-NC component ships in the product; MMS-TTS was evaluated and rejected on that basis. Pairing is deliberately manual, so the sender of an emergency alert is authenticated.
            </Text>
        </Box>

    </Box>

</Slide>
