<Slide style={{ width: 1280, height: 720, padding: '34px 48px 78px 48px', background: '#FFFFFF', fontFamily: 'Calibri', display: 'flex', flexDirection: 'column', position: 'relative' }}>

    <Box style={{ position: 'absolute', left: 0, bottom: 0, width: 1280, height: 56, background: '#0070C0', flexDirection: 'row', alignItems: 'center', padding: '0 48px' }}>
        <Box style={{ width: 210 }}>
            <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>B.J.P (Bug Janta Party)</Text>
        </Box>
        <Box style={{ flex: 1, alignItems: 'center' }}>
            <Text style={{ fontSize: 13, color: '#FFFFFF' }}>@SIH Idea submission- Template</Text>
        </Box>
        <Box style={{ width: 210, alignItems: 'flex-end' }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#FFFFFF' }}>5 / 6</Text>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', height: 74 }}>
        <Box style={{ width: 150, flexDirection: 'row', alignItems: 'center', justifyContent: 'center', height: 56, borderRadius: 28, border: '1.5px solid #7030A0' }}>
            <Text style={{ fontSize: 13, fontWeight: 'bold', color: '#7030A0', textAlign: 'center', lineHeight: 1.2 }}>B.J.P{'\n'}Bug Janta{'\n'}Party</Text>
        </Box>
        <Box style={{ flex: 1, alignItems: 'center' }}>
            <Text style={{ fontSize: 44, fontWeight: 'bold', fontFamily: 'Times New Roman', color: '#1A1A1A', textAlign: 'center' }}>
                IMPACT AND BENEFITS
            </Text>
            <Text style={{ fontSize: 18, color: '#5F5E5A', marginTop: 4 }}>The network carries text. The device handles the voice.</Text>
        </Box>
        <Box style={{ width: 150, alignItems: 'flex-end' }}>
            <Image src='assets/sih_logo.png' style={{ width: 140, height: 66 }} />
        </Box>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', marginTop: 14 }}>

        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#01467D' }}>Potential impact on the target audience</Text>

        <Box style={{ flexDirection: 'row', gap: 16, marginTop: 10 }}>
            {[
                { i: 'briefcase', t: 'Field responders', d: 'Communicate over constrained or congested local links, with no infrastructure to depend on.' },
                { i: 'shield', t: 'Disaster / shelter teams', d: 'Useful exactly when reliable internet and cellular networks are unavailable.' },
                { i: 'cog', t: 'Remote / industrial sites', d: 'Short voice communication where the link is narrow and bandwidth is at a premium.' },
            ].map((a, i) => (
                <Box key={i} style={{ flex: 1, flexDirection: 'row', gap: 12, padding: '12px 14px', background: '#F4F8FC', border: '1px solid #B4B2A9', borderRadius: 6, alignItems: 'flex-start' }}>
                    {i === 0
                        ? (<svg width={26} height={26} viewBox='0 0 24 24'><rect x={2} y={7} width={20} height={14} rx={2} fill='none' stroke='#0070C0' strokeWidth={2} /><path d='M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16' fill='none' stroke='#0070C0' strokeWidth={2} strokeLinecap='round' /></svg>)
                        : i === 1
                            ? (<svg width={26} height={26} viewBox='0 0 24 24'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z' fill='none' stroke='#0070C0' strokeWidth={2} strokeLinejoin='round' /></svg>)
                            : (<svg width={26} height={26} viewBox='0 0 24 24'><circle cx={12} cy={12} r={3} fill='none' stroke='#0070C0' strokeWidth={2} /><path d='M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M19.1 4.9L17 7M7 17l-2.1 2.1' fill='none' stroke='#0070C0' strokeWidth={2} strokeLinecap='round' /></svg>)}
                    <Box style={{ flex: 1 }}>
                        <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#01467D' }}>{a.t}</Text>
                        <Text style={{ fontSize: 13, color: '#1A1A1A', lineHeight: 1.35, marginTop: 3 }}>{a.d}</Text>
                    </Box>
                </Box>
            ))}
        </Box>

        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#01467D', marginTop: 18 }}>Benefits of the solution</Text>

        <Box style={{ flexDirection: 'row', gap: 16, marginTop: 10, flex: 1, alignItems: 'stretch' }}>
            {[
                { i: 'users', h: 'Social', b: 'Voice in, voice out. Usable by people who cannot read or type, because alerts are heard rather than read.', f: 'Inclusive by construction, not by add-on.' },
                { i: 'dollar', h: 'Economic', b: 'No paid API, no cloud subscription, no proprietary SDK. It runs on phones people already own.', f: 'Every model is Apache 2.0 or MIT — no licence fee.' },
                { i: 'chart-line', h: 'Environmental', b: 'Sending text instead of audio lowers the transmitted energy per message by roughly three orders of magnitude.', f: 'Battery runtime effect still to be measured.' },
            ].map((c, i) => (
                <Box key={i} style={{ flex: 1, background: '#FFFFFF', borderTop: '4px solid #01467D', borderRight: '1px solid #B4B2A9', borderBottom: '1px solid #B4B2A9', borderLeft: '1px solid #B4B2A9', borderRadius: 6, padding: 16, flexDirection: 'column' }}>
                    {i === 0
                        ? (<svg width={28} height={28} viewBox='0 0 24 24'><path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2' fill='none' stroke='#0070C0' strokeWidth={2} strokeLinecap='round' /><circle cx={9} cy={7} r={4} fill='none' stroke='#0070C0' strokeWidth={2} /><path d='M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75' fill='none' stroke='#0070C0' strokeWidth={2} strokeLinecap='round' /></svg>)
                        : i === 1
                            ? (<svg width={28} height={28} viewBox='0 0 24 24'><path d='M12 1v22' fill='none' stroke='#0070C0' strokeWidth={2} /><path d='M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6' fill='none' stroke='#0070C0' strokeWidth={2} strokeLinecap='round' /></svg>)
                            : (<svg width={28} height={28} viewBox='0 0 24 24'><path d='M23 6l-9.5 9.5-5-5L1 18' fill='none' stroke='#0070C0' strokeWidth={2} strokeLinecap='round' /><path d='M17 6h6v6' fill='none' stroke='#0070C0' strokeWidth={2} strokeLinecap='round' /></svg>)}
                    <Text style={{ fontSize: 18, fontWeight: 'bold', color: '#01467D', marginTop: 8 }}>{c.h}</Text>
                    <Text style={{ fontSize: 13.5, color: '#1A1A1A', lineHeight: 1.45, marginTop: 6 }}>{c.b}</Text>
                    <Box style={{ flex: 1 }} />
                    <Box style={{ paddingTop: 10, borderTop: '1px solid #D8D6CE' }}>
                        <Text style={{ fontSize: 12.5, color: '#5F5E5A', lineHeight: 1.35 }}>{c.f}</Text>
                    </Box>
                </Box>
            ))}
        </Box>

        <Box style={{ marginTop: 14, padding: '12px 16px', background: '#FFF6EC', borderLeft: '4px solid #E46C0A', borderRadius: 4 }}>
            <Text style={{ fontSize: 13.5, color: '#1A1A1A', lineHeight: 1.4 }}>
                <span style={{ fontWeight: 'bold', color: '#01467D' }}>What is measured and what is not.</span> Measured: accuracy on 2,000 real-speech clips across all ten languages, Android ASR and TTS latency, and memory with the model resident. Not yet measured: field accuracy in noise, phone-class latency, human TTS legibility, and battery runtime. The benefits above are <span style={{ fontWeight: 'bold' }}>proposed outcomes, not measured results</span> — we claim no lives saved.
            </Text>
        </Box>

    </Box>

</Slide>
