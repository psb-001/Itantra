<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Speech capture. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ALERT messages buzz the moment they land, so a phone in a pocket is still noticed. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Bluetooth. On Android 12 (API 31) and above the legacy BLUETOOTH / BLUETOOTH_ADMIN
      permissions are IGNORED — you must request BLUETOOTH_CONNECT and BLUETOOTH_SCAN instead.
      Getting this wrong fails silently: no crash, no dialog, just no connection. Both sets are
      declared so the app works from API 21 up.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />

    <!--
      Wi-Fi Direct. ACCESS_FINE_LOCATION is required to DISCOVER peers on Android 10+.
      That is a documented platform requirement, not a bug, and it is frequently missed.
      NEARBY_WIFI_DEVICES replaces it for discovery on Android 13+.
    -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- Android 12+ ignores a request for FINE location alone; the pair must be declared. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!--
      Alert playback routes through STREAM_ALARM so it is not silenced by ringer modes.
    -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Package visibility (Android 11+, API 30).

      The Licences screen opens model and library source pages in a browser. Since API 30 the
      system hides other packages by default, so an implicit http/https intent can resolve to
      NOTHING unless the app declares what it is looking for. Without this block every "Open
      source page" button on that screen silently does nothing on a modern device — the exact
      failure this project keeps hitting elsewhere, so it is declared rather than discovered.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
    </queries>


    <!--
      tools:targetApi silences UnusedAttribute on dataExtractionRules, which is deliberately
      Android 12+ only. fullBackupContent="false" makes the pre-12 story explicit: allowBackup
      covers the cloud, this covers everything else.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.iTantra"
        tools:targetApi="s">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          About and Licences. NOT exported: nothing outside the app should be able to launch
          them, and they are read-only informational pages. parentActivityName gives them a real
          Up affordance in the system bar as well as the toolbar arrow.
        -->
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LicensesActivity"
            android:exported="false"
            android:parentActivityName=".AboutActivity" />

        <!--
          Lets the DEVICES screen share the log file out to mail / Drive / a file manager, so a
          debugging session does not require a USB cable and adb.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
