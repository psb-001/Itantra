<?xml version="1.0" encoding="utf-8"?>
<!--
  iTantra theme — Material 3.

  The app previously had NO theme file, so it inherited the plain AppCompat default and every
  colour in the layout was a hardcoded literal like #22000000. That is why the UI looked
  unfinished: it was not a design, it was unstyled widgets.

  DARK MODE IS FREE. Every colour below is @color/md_*. The values-night/ copy of
  colors_material.xml defines the same names with dark values, so the system overrides them
  automatically. There is deliberately no second theme and no values-night/themes.xml: two
  themes would let them drift apart, and they always do.

  Colour roles are generated by eval/gen_material_palette.py, which contrast-checks every
  foreground/background pair against WCAG AA and exits non-zero if one fails.
-->
<resources>

    <style name="Base.Theme.iTantra" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand -->
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_onPrimaryContainer</item>
        <item name="colorPrimaryInverse">@color/md_inversePrimary</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_onSecondaryContainer</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_onTertiaryContainer</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_onError</item>
        <item name="colorErrorContainer">@color/md_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_onErrorContainer</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_onBackground</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_onSurfaceVariant</item>
        <item name="colorSurfaceContainerLowest">@color/md_surfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/md_surfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/md_surfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/md_surfaceContainerHighest</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outlineVariant</item>
        <item name="colorSurfaceInverse">@color/md_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverseOnSurface</item>

        <!--
          ALERT COLOURS ARE NOT THE ERROR COLOURS, DELIBERATELY.

          A segment the recogniser got wrong is recoverable — the sender is told to repeat — and
          must not look like a siren. Only a real emergency alert uses the saturated red.
          Conflating the two trains people to ignore red, which is exactly backwards here.
        -->
        <item name="iTantraAlert">@color/md_alert</item>
        <item name="iTantraOnAlert">@color/md_onAlert</item>
        <item name="iTantraAlertContainer">@color/md_alertContainer</item>
        <item name="iTantraOnAlertContainer">@color/md_onAlertContainer</item>

        <!-- Draw behind the system bars so the app's own surface runs to the edges. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/md_surface</item>

        <item name="materialCardViewStyle">@style/Widget.iTantra.CardView</item>
        <item name="toolbarStyle">@style/Widget.iTantra.Toolbar</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.iTantra.AlertDialog</item>
    </style>

    <style name="Theme.iTantra" parent="Base.Theme.iTantra" />

    <style name="ThemeOverlay.iTantra.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog" />

    <style name="Widget.iTantra.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="Widget.iTantra.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/TextAppearance.iTantra.ToolbarTitle</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.iTantra.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- The push-to-talk button is the entire app. Make it the biggest thing on screen. -->
    <style name="Widget.iTantra.Button.Ptt" parent="Widget.Material3.Button">
        <item name="android:minHeight">76dp</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.iTantra.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="Widget.iTantra.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.iTantra.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- Monospace for the diagnostics log; onSurfaceVariant so it stays readable but quiet. -->
    <style name="TextAppearance.iTantra.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Section heading inside the About / Licences screens. -->
    <style name="TextAppearance.iTantra.SectionHeader" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
