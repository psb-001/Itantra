<?xml version="1.0" encoding="utf-8"?>
<!--
  iTantra launcher icon — background layer (adaptive icon, API 26+).

  A plain navy field. The glyph lives in ic_launcher_foreground.xml inside the 66dp safe
  zone, so every mask the launcher applies (circle, squircle, rounded square) crops only
  this background. #142D4E has been the app's icon ground since the first placeholder and
  matches the navy the deck and README screenshots use — do not change it without changing
  app/branding/icon.svg, which is the design source these vectors were drawn from.

  Legacy devices (API 23–25) never see this file: they load the pre-rendered PNGs in
  res/mipmap-*/ic_launcher.png, which are rasterised from the same source.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#142D4E"
        android:pathData="M0,0h108v108h-108z" />
</vector>
