<?xml version="1.0" encoding="utf-8"?>
<!--
  The connection indicator dot. A shape drawable rather than a View background tint so the same
  drawable can be recoloured from code (grey -> green on connect) without a second resource.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#747780" />
</shape>
