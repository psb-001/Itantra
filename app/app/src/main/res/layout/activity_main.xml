<?xml version="1.0" encoding="utf-8"?>
<!--
  iTantra main screen — Material 3.

  Rewritten from a flat LinearLayout of raw TextViews and Buttons with hardcoded colours like
  #22000000. The structure is the same (it works, and the IDs are referenced from
  MainActivity.kt), but everything is now a Material component themed from values/themes.xml, so
  the app follows the system light/dark setting and every colour is contrast-checked.

  ORDER OF SCREEN REAL ESTATE, top to bottom, is deliberate:
    connection  ->  is the link up?
    status      ->  what is the app doing right now?
    transcript  ->  the actual conversation, largest area, bottom-aligned so new text sits
                    just above the button where the eye already is
    PTT         ->  the one control, 76dp, biggest and brightest thing on screen
    tools       ->  devices / settings / about, quiet text buttons

  A diagnosis log is available behind a toggle rather than permanently on screen. It is genuinely
  useful (it is how the 15 silent bugs in this project were found) but it is noise during a demo.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <!-- Connection state. Its background colour is set in code so it can turn red. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/connection_card"
            style="@style/Widget.iTantra.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- A dot, so connection is readable at a glance without reading words. -->
                <View
                    android:id="@+id/connection_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/connection"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/not_connected"
                    android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/loading"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <!--
          Mic level, shown twice on purpose.

          The LinearProgressIndicator is the glanceable part. The monospace TextView is the
          diagnostic part: an ASCII bar plus the numeric peak, which is what proves the
          microphone is genuinely delivering audio rather than silently returning zeros. That
          distinction is the difference between "nothing happened" and "the mic is dead", and it
          is how several of this project's silent bugs were tracked down. Replacing the text
          with a pretty bar would have thrown that away.
        -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/level_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:visibility="invisible"
            app:trackCornerRadius="4dp"
            app:trackThickness="6dp" />

        <TextView
            android:id="@+id/level"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.iTantra.Mono" />

        <TextView
            android:id="@+id/transcript"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp"
            android:gravity="bottom"
            android:lineSpacingMultiplier="1.25"
            android:scrollbars="vertical"
            android:text="@string/hint"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ptt_button"
            style="@style/Widget.iTantra.Button.Ptt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:enabled="false"
            android:text="@string/ptt" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/devices_button"
                style="@style/Widget.iTantra.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/devices" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settings_button"
                style="@style/Widget.iTantra.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/about_button"
                style="@style/Widget.iTantra.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/about" />
        </LinearLayout>

        <!-- Diagnostics, hidden until asked for. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/log_toggle"
            style="@style/Widget.iTantra.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/show_log" />

        <ScrollView
            android:id="@+id/log_scroll"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="4dp"
            android:background="?attr/colorSurfaceContainerLow"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:visibility="gone">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:textAppearance="@style/TextAppearance.iTantra.Mono"
                android:textIsSelectable="true" />
        </ScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
