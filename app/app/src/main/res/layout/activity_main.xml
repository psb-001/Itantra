<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/connection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="#22000000"
        android:textSize="15sp"
        android:textStyle="bold"
        android:text="@string/not_connected" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textSize="13sp"
        android:text="@string/loading" />

    <TextView
        android:id="@+id/level"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:text="" />

    <!--
      The transcript and the log both scroll. The log used to be a fixed-height TextView that
      simply clipped whatever did not fit, which made it useless for reading anything longer
      than a few lines.
    -->
    <TextView
        android:id="@+id/transcript"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:gravity="bottom"
        android:scrollbars="vertical"
        android:textSize="18sp"
        android:text="@string/hint" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="110dp"
        android:layout_marginTop="6dp"
        android:background="#11000000"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="6dp"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:text="" />
    </ScrollView>

    <Button
        android:id="@+id/ptt_button"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="6dp"
        android:enabled="false"
        android:textSize="18sp"
        android:text="@string/ptt" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/devices_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="@string/devices" />

        <Button
            android:id="@+id/settings_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="@string/settings" />
    </LinearLayout>

</LinearLayout>
