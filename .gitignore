*.onnx
*.tflite
*.bin
*.pt
*.ckpt
models/reference-apk/
app/app/src/main/assets/sherpa-onnx-*/
app/app/src/main/assets/tts/*.onnx

# Laya triage: the int8 encoder (118 MB) and head (25 MB), staged into app assets by
# app/setup-project.sh. The compact tokenizer it reads beside them (vocab.b64, merges.b64,
# config.json — 530 KB of text) IS committed: the JVM parity test and the app both depend on it.
models/laya-int8/

# ---------- Compiled release artifacts (~1.0 GB) ----------
# Ship these as GitHub Release assets, not in git history.
releases/
*.apk
*.aab

# ---------- Release signing (never in git) ----------
# keystore.properties holds the store/key password; *.jks is the key itself.
# The Sep 2026 keystore was committed before this rule existed and was retired on
# 16 Oct 2026 because of it (see docs/RELEASE.md) — nothing may add a key back here.
keystore.properties
*.jks

# ---------- Datasets (7.1 GB) ----------
# Re-fetchable: eval/fetch_missing_langs.sh
dataset/

